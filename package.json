{
  "name": "@bostonuniversity/buwp-cloud",
  "version": "0.1.1",
  "description": "Command-line tools for operating Boston University's WordPress clusters on AWS ECS",
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "buwp-cloud": "bin/buwp-cloud.js"
  },
  "files": [
    "bin/",
    "lib/"
  ],
  "scripts": {
    "test": "node --test 'test/**/*.test.js'",
    "buwp-cloud": "node bin/buwp-cloud.js",
    "lint": "eslint .",
    "prepublishOnly": "npm test && npm run lint"
  },
  "keywords": [
    "wordpress",
    "aws",
    "ecs",
    "bu",
    "cli"
  ],
  "author": "Boston University",
  "license": "GPL-2.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jdub233/buwp-cloud.git"
  },
  "homepage": "https://github.com/jdub233/buwp-cloud#readme",
  "bugs": {
    "url": "https://github.com/jdub233/buwp-cloud/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.1169.0",
    "@aws-sdk/client-ecs": "^3.1164.0",
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/client-secrets-manager": "^3.1164.0",
    "chalk": "^4.1.2",
    "commander": "^11.0.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "eslint": "^8.50.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
